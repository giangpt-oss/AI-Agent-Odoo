# Application
APP_NAME=Enterprise-AI-Agent
APP_ENV=development
APP_SECRET_KEY=change-this-super-secret-key-in-production-min-32-chars
APP_DEBUG=False
HOST=0.0.0.0
PORT=8000

# Database & Cache
DATABASE_URL=postgresql+asyncpg://postgres:odoo@localhost:5432/ai_agent_db
REDIS_URL=redis://localhost:6379/0

# LLM Providers (ít nhất 1 key)
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
DEFAULT_LLM_PROVIDER=gemini
DEFAULT_LLM_MODEL=gemini-2.5-flash

# Telegram Bot
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_WEBHOOK_SECRET=telegram_webhook_secret_here

# Odoo Cloud (External ERP API)
ODOO_URL=https://your-company.odoo.com
ODOO_DB=your_company_db_name
ODOO_WEBHOOK_SECRET=replace-with-a-random-webhook-secret
# Tài khoản bot/integration mặc định hoặc dùng per-user API key
ODOO_ADMIN_USERNAME=bot_agent@company.com
ODOO_API_KEY=your_odoo_api_key_here

# Google Integration (OAuth2)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/oauth/google/callback

# Security & Encryption (Fernet key để mã hóa Token người dùng trong DB)
# Tạo bằng: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=W3u59Z0b-4j_1KqgW72Z46v1qG8k0e3HwKxP0aM9tN4=

# Emergency Kill Switch (Mặc định False = Hệ thống hoạt động bình thường)
EMERGENCY_KILL_SWITCH=False
